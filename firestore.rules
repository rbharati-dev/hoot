rules_version = '2';
// Hoot: each person can read and write only their own progress.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Synced progress: one small document per kind of data.
    match /users/{uid}/data/{key} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && key.matches('^hoot[.][A-Za-z.]{2,40}$')
        && request.resource.data.keys().hasOnly(['json', 'updatedAt'])
        && request.resource.data.json is string
        && request.resource.data.json.size() <= 900000
        && request.resource.data.updatedAt == request.time;
    }

    // The account record: just the chosen username.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['username', 'createdAt'])
        && request.resource.data.username is string
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
    }

    // ---- Life stories ----
    // Each memory the person writes or records: their own words and choices,
    // kept as one JSON value (like synced progress). Only they can read it.
    match /users/{uid}/stories/{memoryId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && memoryId.matches('^[A-Za-z0-9_-]{6,64}$')
        && request.resource.data.keys().hasOnly(['json', 'updatedAt', 'deleted'])
        && request.resource.data.json is string
        && request.resource.data.json.size() <= 900000
        && request.resource.data.updatedAt == request.time
        && (!('deleted' in request.resource.data) || request.resource.data.deleted is bool);
    }

    // A recording the app has uploaded. The app may only register it (with
    // status "uploaded" and its own file path); everything after that —
    // transcript, story, status, measured duration — is written by the server.
    match /users/{uid}/recordings/{recId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && recId.matches('^[A-Za-z0-9_-]{6,64}$')
        && request.resource.data.keys().hasOnly(['memoryId', 'storagePath', 'mime', 'size', 'clientDuration', 'language', 'style', 'hints', 'question', 'createdAt', 'status'])
        && request.resource.data.status == 'uploaded'
        && request.resource.data.createdAt == request.time
        && request.resource.data.memoryId is string && request.resource.data.memoryId.matches('^[A-Za-z0-9_-]{6,64}$')
        && request.resource.data.storagePath == 'users/' + uid + '/recordings/' + recId
        && request.resource.data.mime is string && request.resource.data.mime.size() <= 60
        && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 26214400
        && request.resource.data.clientDuration is number && request.resource.data.clientDuration >= 0
        && request.resource.data.language is string && request.resource.data.language.size() <= 5
        && request.resource.data.style in ['own_words', 'polished', 'book']
        && request.resource.data.hints is list && request.resource.data.hints.size() <= 50
        && request.resource.data.question is string && request.resource.data.question.size() <= 300;
      allow update, delete: if false;
    }

    // Usernames are unique: a name can be claimed once, only for yourself,
    // and only released by its owner. Anyone signed in may check whether a
    // single name is taken (no listing).
    match /usernames/{name} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && name.matches('^[a-z0-9][a-z0-9._-]{1,18}[a-z0-9]$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Anonymous usage counts: daily totals per event, nothing about the person.
    // Anyone may add 1–50 to a counter; nobody can read them from the app.
    match /stats/{day}/events/{event} {
      allow read: if false;
      allow create: if day.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && event.matches('^[a-z][a-z0-9_.]{1,59}$')
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n is int
        && request.resource.data.n >= 1 && request.resource.data.n <= 50;
      allow update: if request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n is int
        && request.resource.data.n > resource.data.n
        && request.resource.data.n <= resource.data.n + 50;
    }

    // Error reports: write-only short technical notes.
    match /errors/{id} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['msg', 'where', 'stack', 'ua', 'day'])
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 300
        && request.resource.data.where is string && request.resource.data.where.size() <= 100
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 500
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 150
        && request.resource.data.day is string && request.resource.data.day.size() == 10;
    }

    // usageLedger, usageDaily, jobs, rateLimits: server only (covered below).
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
