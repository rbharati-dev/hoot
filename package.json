{
  "name": "hoot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-content.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "content": "node scripts/build-content.mjs",
    "overnight": "tsx scripts/overnight.mts",
    "check:content": "node scripts/check-content.mjs",
    "enrich:music": "node scripts/enrich-music.mjs",
    "build:news": "node scripts/build-news.mjs",
    "build:health-news": "node scripts/build-health-news.mjs",
    "translate:content": "node scripts/translate-content.mjs",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:accounts": "playwright test -c playwright.account.config.ts",
    "find:videos": "node scripts/find-videos.mjs",
    "check:videos": "node scripts/check-videos.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-hoot 'vitest run --config vitest.rules.config.ts'"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "firebase": "^11.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "1.56",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^14.27.0",
    "linkedom": "^0.18.13",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  }
}
