# Hoot story processing settings (not secrets; API keys live in Secret Manager).
# Which services turn speech into text and text into a readable story.
TRANSCRIBE_PROVIDER=openai
TRANSCRIBE_MODEL=gpt-transcribe
EDIT_PROVIDER=anthropic
EDIT_MODEL=claude-sonnet-5-5
# Operational safeguards (protect against runaway costs; not a paywall).
MAX_UPLOAD_MB=24
MAX_RECORDING_SECONDS=3600
MAX_RETRIES=4
DAILY_SECONDS_LIMIT=14400
DAILY_RECORDINGS_LIMIT=60
# Cost estimates in USD, used only where a provider doesn't report its cost.
TRANSCRIBE_USD_PER_MIN=0.0045
EDIT_USD_PER_MTOK_IN=3
EDIT_USD_PER_MTOK_OUT=15
STORAGE_USD_PER_GB_MONTH=0.026
# Comma-separated account ids allowed to see the usage report.
ADMIN_UIDS=
